    {
      "left": "SPP",
      "right": "SPP",
      "source_ids": [
        "q-ffkl02"
      ],
      "justification": "From a 0/1 GapP gap g, use 1−g."
    },
    {
      "left": "LWPP",
      "right": "LWPP",
      "source_ids": [
        "q-ffkl02"
      ],
      "justification": "Replace gap g by f(0^|x|)−g; the length-dependent normalizer is unchanged."
    },
    {
      "left": "WPP",
      "right": "WPP",
      "source_ids": [
        "q-ffkl02"
      ],
      "justification": "Replace gap g by f(x)−g; the FP normalizer is unchanged."
    },
    {
      "left": "AWPP",
      "right": "AWPP",
      "source_ids": [
        "q-ffkl02"
      ],
      "justification": "Replace approximating gap g by f−g to exchange the near-zero and near-one intervals."
    },
    {
      "left": "PP",
      "right": "PP",
      "source_ids": [
        "q-ffkl02"
      ],
      "justification": "If membership means integer GapP gap g>0, then 1−2g>0 holds exactly on nonmembers."
    },
    {
      "left": "parityP",
      "right": "parityP",
      "source_ids": [
        "q-ffkl02"
      ],
      "justification": "Replace GapP gap g by g+1 to exchange odd and even parity."
    },
    {
      "left": "BQP",
      "right": "BQP",
      "source_ids": [
        "q-watrous08"
      ],
      "justification": "Flip the output bit, exchanging bounded-error acceptance and rejection."
    },
    {
      "left": "SZK",
      "right": "SZK",
      "source_ids": [
        "q-gsv98"
      ],
      "justification": "HVSZK is closed under complement and equals SZK; Section 1 credits Okamoto and Sahai–Vadhan for the complement theorem."
    },
    {
