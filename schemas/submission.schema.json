            "QMA",
            "coQMA",
            "BQP",
            "SBP",
            "SZK",
            "NPcapcoNP",
            "Sigma2P",
            "Pi2P",
            "Delta2P",
            "Theta2P",
            "PH",
            "Ppoly",
            "NPpoly",
            "PSPACE",
            "EXP",
            "NEXP",
            "EXPSPACE",
            "E",
