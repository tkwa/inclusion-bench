            "BQL",
            "ExistsR",
            "PSharpP",
            "CH",
            "QMA2",
            "StoqMA",
            "QSZK",
            "UniformNC1"
          ]
        },
        "right": {
          "enum": [
            "AC0",
            "ACC0",
