{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InclusionBench scenario or proposed submission",
  "type": "object",
  "required": [
    "claims"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "maxItems": 2500,
      "items": {
        "$ref": "#/$defs/atom"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "statement",
          "proof_kind"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "proof_kind": {
            "enum": [
              "lean",
              "paper",
              "zfc_independence"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "atom": {
      "type": "object",
      "required": [
        "relation",
        "left",
        "right"
      ],
      "properties": {
        "relation": {
          "enum": [
            "inclusion",
            "separation",
            "independence"
          ]
        },
        "left": {
          "enum": [
            "AC0",
            "ACC0",
            "TC0",
            "NC1",
            "L",
            "NL",
            "LogCFL",
            "NC",
            "SC",
            "P",
            "RP",
            "coRP",
            "ZPP",
            "BPP",
            "UP",
