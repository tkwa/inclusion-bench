{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InclusionBench AI run manifest v1",
  "description": "The serialized run.json emitted by the draft adapter runner. Shape validation does not verify proofs, resource enforcement, historical eligibility, task coverage, or leaderboard admission. Class and task membership, unique attempt IDs, file hashes, prompt hashes, dataset identity, timestamps, and trusted reviews require runtime checks.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "model",
    "track",
    "dataset_sha256",
    "taskset_sha256",
    "budget",
    "attempts",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "description": "Exact model identity; additional provider, snapshot and generation configuration fields may be recorded."
    },
    "track": {
      "enum": [
        "closed-book",
        "tool-assisted",
        "smoke-test"
      ]
    },
    "dataset_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "taskset_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "budget": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "wall_time_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_cpu_cores": {
          "type": "integer",
          "minimum": 1
        },
        "memory_limit_mib": {
          "type": "integer",
          "minimum": 1
        },
        "enforcement": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "description": "Declared run limits and their enforcement. The adapter runner permits wall_time_seconds from 1 through 86400; resource declarations alone do not establish enforcement."
    },
    "tools": {
      "type": "object",
      "properties": {
        "adapter_command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "external_tool_policy": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "#/$defs/timestamp"
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      },
      "description": "All attempts in this run, including failures. An empty or partial list does not qualify as a full-suite leaderboard entry. The runner checks attempt ID uniqueness and task membership."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\u0000]+$",
      "description": "A relative file path inside the run directory. Absolute paths and parent traversal are forbidden. The runner separately checks file existence and containment after resolving symlinks."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:[zZ]|[+-][0-9]{2}:[0-9]{2})$",
      "description": "An RFC 3339 timestamp with an explicit timezone. Enable format assertions when using a JSON Schema validator. The runner also verifies that finished_at is not earlier than started_at."
    },
    "atom": {
      "type": "object",
      "required": [
        "relation",
        "left",
        "right"
      ],
      "properties": {
        "relation": {
          "enum": [
            "inclusion",
            "separation",
            "independence"
          ]
        },
        "left": {
          "enum": [
            "AC0",
            "ACC0",
            "TC0",
            "NC1",
            "L",
            "NL",
            "LogCFL",
            "NC",
            "SC",
            "P",
            "RP",
            "coRP",
            "ZPP",
            "BPP",
            "UP",
            "coUP",
            "NP",
            "coNP",
            "FewP",
            "SPP",
            "CeqP",
            "PP",
            "parityP",
            "AWPP",
            "LWPP",
            "WPP",
            "MA",
            "coMA",
            "AM",
            "coAM",
            "QCMA",
            "QMA",
            "coQMA",
            "BQP",
            "SBP",
            "SZK",
            "NPcapcoNP",
            "Sigma2P",
            "Pi2P",
            "Delta2P",
            "Theta2P",
            "PH",
            "Ppoly",
            "NPpoly",
            "PSPACE",
            "EXP",
            "NEXP",
            "EXPSPACE",
            "E",
            "NE"
          ]
        },
        "right": {
          "enum": [
            "AC0",
            "ACC0",
            "TC0",
            "NC1",
            "L",
            "NL",
            "LogCFL",
            "NC",
            "SC",
            "P",
            "RP",
            "coRP",
            "ZPP",
            "BPP",
            "UP",
            "coUP",
            "NP",
            "coNP",
            "FewP",
            "SPP",
            "CeqP",
            "PP",
            "parityP",
            "AWPP",
            "LWPP",
            "WPP",
            "MA",
            "coMA",
            "AM",
            "coAM",
            "QCMA",
            "QMA",
            "coQMA",
            "BQP",
            "SBP",
            "SZK",
            "NPcapcoNP",
            "Sigma2P",
            "Pi2P",
            "Delta2P",
            "Theta2P",
            "PH",
            "Ppoly",
            "NPpoly",
            "PSPACE",
            "EXP",
            "NEXP",
            "EXPSPACE",
            "E",
            "NE"
          ]
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "attempt": {
      "type": "object",
      "required": [
        "attempt_id",
        "task_id",
        "status",
        "claims",
        "artifacts"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "pattern": "^inclusion\\.[A-Za-z][A-Za-z0-9]*\\.[A-Za-z][A-Za-z0-9]*$"
        },
        "status": {
          "enum": [
            "unsolved",
            "proof_candidate",
            "error",
            "budget_exhausted"
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/atom"
          },
          "default": []
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "default": []
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "request_path": {
          "$ref": "#/$defs/relativePath"
        },
        "error": {
          "type": "string"
        }
      },
      "dependentRequired": {
        "request_path": [
          "prompt_sha256"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "proof_candidate"
              }
            }
          },
          "then": {
            "properties": {
              "claims": {
                "minItems": 1
              },
              "artifacts": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "claims": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
