{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InclusionBench AI run manifest v2 (with legacy v1 support)",
  "description": "Operational v2 run.json, including running checkpoints and sealed evidence; legacy v1 records remain readable. Shape validation does not verify proofs, budgets, historical eligibility or admission. The runtime also checks hash identities, assignment/configuration agreement, transcript coverage, exact usage totals, chronology, and trusted review records.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "model",
    "track",
    "dataset_sha256",
    "taskset_sha256",
    "budget",
    "attempts",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "description": "Exact model identity; additional provider, snapshot and generation configuration fields may be recorded."
    },
    "track": {
      "enum": [
        "closed-book",
        "tool-assisted",
        "smoke-test"
      ]
    },
    "dataset_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "taskset_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "budget": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "wall_time_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_cpu_cores": {
          "type": "integer",
          "minimum": 1
        },
        "memory_limit_mib": {
          "type": "integer",
          "minimum": 1
        },
        "enforcement": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "description": "Declared run limits and their enforcement. The adapter runner permits wall_time_seconds from 1 through 86400; resource declarations alone do not establish enforcement."
    },
    "tools": {
      "type": "object",
      "properties": {
        "adapter_command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "external_tool_policy": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "#/$defs/timestamp"
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      },
      "description": "All attempts in this run, including failures. An empty or partial list does not qualify as a full-suite leaderboard entry. The runner checks attempt ID uniqueness and task membership."
    },
    "state": {
      "enum": [
        "running",
        "sealed"
      ]
    },
    "provider": {
      "enum": [
        "openai",
        "anthropic",
        "fixture",
        "custom"
      ]
    },
    "configuration": {
      "$ref": "#/$defs/v2Configuration"
    },
    "configuration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "assigned_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/taskId"
      }
    },
    "assignment_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "usage": {
      "type": "object",
      "required": [
        "charged_tokens",
        "measured_input_tokens",
        "measured_output_tokens"
      ],
      "properties": {
        "charged_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "measured_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "measured_output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "resume_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timestamp"
      }
    },
    "evidence_index": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/relativePath"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      },
      "description": "Relative evidence file paths mapped to SHA-256. Sealed runs must cover the runner-owned transcripts, configuration and every declared artifact; runtime checks coverage and actual file bytes."
    },
    "unattempted_task_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/taskId"
      }
    },
    "in_flight": {
      "type": "object",
      "required": [
        "attempt_id",
        "task_id",
        "started_at",
        "request_path",
        "prompt_sha256"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "$ref": "#/$defs/taskId"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "request_path": {
          "$ref": "#/$defs/relativePath"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\u0000]+$",
      "description": "A relative file path inside the run directory. Absolute paths and parent traversal are forbidden. The runner separately checks file existence and containment after resolving symlinks."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:[zZ]|[+-][0-9]{2}:[0-9]{2})$",
      "description": "An RFC 3339 timestamp with an explicit timezone. Enable format assertions when using a JSON Schema validator. The runner also verifies that finished_at is not earlier than started_at."
    },
    "atom": {
      "type": "object",
      "required": [
        "relation",
        "left",
        "right"
      ],
      "properties": {
        "relation": {
          "enum": [
            "inclusion",
            "separation",
            "independence"
          ]
        },
        "left": {
          "enum": [
            "AC0",
            "ACC0",
            "TC0",
            "NC1",
            "L",
            "NL",
            "LogCFL",
            "NC",
            "SC",
            "P",
            "RP",
            "coRP",
            "ZPP",
            "BPP",
            "UP",
            "coUP",
            "NP",
            "coNP",
            "FewP",
            "SPP",
            "CeqP",
            "PP",
            "parityP",
            "AWPP",
            "LWPP",
            "WPP",
            "MA",
            "coMA",
            "AM",
            "coAM",
            "QCMA",
            "QMA",
            "coQMA",
            "BQP",
            "SBP",
            "SZK",
            "NPcapcoNP",
            "Sigma2P",
            "Pi2P",
            "Delta2P",
            "Theta2P",
            "PH",
            "Ppoly",
            "NPpoly",
            "PSPACE",
            "EXP",
            "NEXP",
            "EXPSPACE",
            "E",
            "NE"
          ]
        },
        "right": {
          "enum": [
            "AC0",
            "ACC0",
            "TC0",
            "NC1",
            "L",
            "NL",
            "LogCFL",
            "NC",
            "SC",
            "P",
            "RP",
            "coRP",
            "ZPP",
            "BPP",
            "UP",
            "coUP",
            "NP",
            "coNP",
            "FewP",
            "SPP",
            "CeqP",
            "PP",
            "parityP",
            "AWPP",
            "LWPP",
            "WPP",
            "MA",
            "coMA",
            "AM",
            "coAM",
            "QCMA",
            "QMA",
            "coQMA",
            "BQP",
            "SBP",
            "SZK",
            "NPcapcoNP",
            "Sigma2P",
            "Pi2P",
            "Delta2P",
            "Theta2P",
            "PH",
            "Ppoly",
            "NPpoly",
            "PSPACE",
            "EXP",
            "NEXP",
            "EXPSPACE",
            "E",
            "NE"
          ]
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "attempt": {
      "type": "object",
      "required": [
        "attempt_id",
        "task_id",
        "status",
        "claims",
        "artifacts"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "$ref": "#/$defs/taskId"
        },
        "status": {
          "enum": [
            "unsolved",
            "proof_candidate",
            "error",
            "budget_exhausted"
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/atom"
          },
          "default": []
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "default": []
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "request_path": {
          "$ref": "#/$defs/relativePath"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "finished_at": {
          "$ref": "#/$defs/timestamp"
        },
        "usage": {
          "$ref": "#/$defs/providerUsage"
        },
        "usage_complete": {
          "type": "boolean"
        },
        "budget_charge_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "request_made": {
          "type": "boolean"
        },
        "provider_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "response_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "finish_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "dependentRequired": {
        "request_path": [
          "prompt_sha256"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "proof_candidate"
              }
            }
          },
          "then": {
            "properties": {
              "claims": {
                "minItems": 1
              },
              "artifacts": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "claims": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "v2Budget": {
      "type": "object",
      "required": [
        "wall_time_seconds",
        "per_task_wall_time_seconds",
        "max_total_tokens",
        "max_output_tokens_per_task",
        "max_cpu_cores",
        "memory_limit_mib"
      ],
      "properties": {
        "wall_time_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "per_task_wall_time_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens_per_task": {
          "type": "integer",
          "minimum": 1
        },
        "max_cpu_cores": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "memory_limit_mib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      },
      "additionalProperties": true,
      "description": "Declared budget. The runner also checks per-task versus total limits and their enforcement."
    },
    "taskId": {
      "type": "string",
      "pattern": "^inclusion\\.[A-Za-z][A-Za-z0-9]*\\.[A-Za-z][A-Za-z0-9]*$"
    },
    "providerUsage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "provider_usage": {
          "type": "object"
        },
        "usage_complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "description": "Measured provider token counts. Unknown measurements are null, not zero. Counts and their sums are checked by the runner."
    },
    "v2Configuration": {
      "type": "object",
      "required": [
        "schema_version",
        "model",
        "track",
        "adapter",
        "budget",
        "assigned_task_ids"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "model": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true,
          "description": "Exact model identity; additional provider, snapshot and generation configuration fields may be recorded."
        },
        "track": {
          "enum": [
            "closed-book",
            "tool-assisted",
            "smoke-test"
          ]
        },
        "provider": {
          "enum": [
            "openai",
            "anthropic",
            "fixture",
            "custom"
          ]
        },
        "adapter": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "budget": {
          "$ref": "#/$defs/v2Budget"
        },
        "assigned_task_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/taskId"
          }
        },
        "selection": {
          "type": "object"
        },
        "configuration": {
          "type": "object"
        },
        "tools": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "state",
          "provider",
          "configuration",
          "configuration_sha256",
          "assigned_task_ids",
          "assignment_sha256",
          "usage",
          "resume_events",
          "evidence_index"
        ],
        "properties": {
          "budget": {
            "$ref": "#/$defs/v2Budget"
          },
          "attempts": {
            "items": {
              "required": [
                "started_at",
                "usage_complete",
                "budget_charge_tokens"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "sealed"
                }
              }
            },
            "then": {
              "required": [
                "unattempted_task_ids"
              ],
              "not": {
                "required": [
                  "in_flight"
                ]
              },
              "properties": {
                "evidence_index": {
                  "minProperties": 2
                }
              }
            }
          }
        ]
      }
    }
  ]
}
