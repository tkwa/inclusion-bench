import InclusionQuantum.Normalization

/-!
# Polynomial-time quantum logspace

The input-dependent circuit is generated by one concrete deterministic
logspace transducer on the classical input. Only O(log n) quantum wires are
initialized, all to zero; the n-bit input is not copied into quantum workspace.
The generator's work tape and runtime are both bounded on every input, its
output is write-only, and the circuit has a separate polynomial gate bound.

This is the unitary, logspace-uniform circuit characterization, restricted to
total languages. The equivalence with quantum Turing machines and the removal
of intermediate measurements are cited model bridges, not proved here:
Fefferman and Remscrim, STOC 2021, https://arxiv.org/abs/2006.03530 .
The polynomial time condition is essential. Unrestricted-time bounded-error
quantum logspace is PL: Le Gall, Nishimura and Yakaryilmaz, TQC 2021,
https://arxiv.org/abs/2105.02681 .
-/

namespace InclusionBench.Quantum

open Counting (polynomialValue)

noncomputable section

abbrev InputCircuitFamily (width : Nat → Nat) :=
  (input : Word) → Circuit (width input.length)

def logspaceInputUniform {width : Nat → Nat} (family : InputCircuitFamily width) : Prop :=
  ∃ generator : Transducers.Transducer, ∃ runtime : List Nat, ∃ coefficient : Nat,
    ∀ input,
      generator.haltsAt input (polynomialValue runtime input.length) ∧
      generator.output input (polynomialValue runtime input.length) = (family input).serialize ∧
      ∀ time ≤ polynomialValue runtime input.length,
        (generator.after input time).workSpace ≤
          coefficient * (Nat.log2 (input.length + 1) + 1)

def zeroState (qubits : Nat) : State qubits := basisState (fun _ => false)

theorem zeroState_normalized (qubits : Nat) : Normalized (zeroState qubits) :=
  basisState_normalized _

def logspaceAcceptance {width : Nat → Nat} (family : InputCircuitFamily width)
    (input : Word) : ℝ :=
  (family input).acceptanceProbability (zeroState (width input.length))

def BQL : ComplexityClass :=
  fun L => ∃ width : Nat → Nat, ∃ family : InputCircuitFamily width,
    logspaceInputUniform family ∧
    (∃ coefficient : Nat, ∀ n, width n ≤ coefficient * (Nat.log2 (n + 1) + 1)) ∧
    (∃ gateBound : List Nat, ∀ input,
      (family input).gates.length ≤ polynomialValue gateBound input.length) ∧
    ∀ input,
      (L input → 2 ≤ 3 * logspaceAcceptance family input) ∧
      (¬ L input → 3 * logspaceAcceptance family input ≤ 1)

theorem logspaceAcceptance_bounded {width : Nat → Nat}
    (family : InputCircuitFamily width) (input : Word) :
    0 ≤ logspaceAcceptance family input ∧ logspaceAcceptance family input ≤ 1 :=
  acceptanceProbability_bounded _ _ (zeroState_normalized _)

end
end InclusionBench.Quantum
